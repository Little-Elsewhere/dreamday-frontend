{
  "name": "next16-codebase",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "make dev",
    "build:dev": "doppler run --project dreamday --config dev -- next build",
    "build:prod": "doppler run --project dreamday --config prod -- next build",
    "start": "doppler run --project dreamday --config dev --no-fallback -- sh scripts/start-standalone.sh",
    "supabase:templates": "node scripts/build-supabase-email-templates.mjs",
    "supabase:start": "make supabase-start",
    "supabase:stop": "make supabase-stop",
    "supabase:status": "make supabase-status",
    "supabase:reset:local": "make supabase-reset-local",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e:trips": "playwright test --config playwright.trips.config.ts",
    "prepare": "husky",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "next-intl": "^4.13.6",
    "posthog-js": "1.417.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@serwist/turbopack": "^9.5.12",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-storybook": "^10.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-please": "^17.11.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.17.0",
    "storybook": "^10.6.0",
    "supabase": "2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
