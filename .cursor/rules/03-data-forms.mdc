# Data Fetching, Server Actions, Forms, and State Management

## 1. Data Fetching & Server Actions

- Fetch data in Server Components using async/await.
- Use Server Actions for ALL mutations (forms, writes, deletes). Server Actions live in src/app/actions.ts or co-located as actions.ts inside feature folders.
- Validate ALL inputs in Server Actions using Zod.
- Validate form values with `schema.parse(...)` immediately when a Server Action starts, before its `try/catch`. Invalid form values MUST throw `ZodError`; do not use `safeParse()` or convert that error to an Action result.
- After form validation succeeds, handle domain and service failures with the Action result contract. Validate non-form inputs according to their own boundary requirements.
- Use revalidatePath() or revalidateTag() after mutations to clear cache.
- NEVER fetch initial page data inside useEffect.

```tsx
// src/features/posts/actions.ts
'use server'

import { revalidatePath } from 'next/cache'
import { createPostSchema } from '@/features/posts/schemas/post'

type CreatePostResult = { success: true } | { success: false; error: 'saveFailed' }

export async function createPost(input: unknown): Promise<CreatePostResult> {
  const validated = createPostSchema.parse(input)

  try {
    await db.post.create({ data: validated })
    revalidatePath('/posts')
    return { success: true }
  } catch {
    return { success: false, error: 'saveFailed' }
  }
}
```

## 2. Forms

- Use React Hook Form (`useForm`, `register`, and `handleSubmit`) to manage interactive form state and submission.
- Define each form's validation with a Zod schema in the feature's `schemas/` folder and connect it to React Hook Form with `zodResolver` from `@hookform/resolvers/zod`.
- Export schema-derived input/output types next to the schema when components or actions need them. Use `z.input<typeof schema>` and `z.output<typeof schema>` when Zod transforms make the input and validated output differ.
- Submit validated values through a Server Action. Client-side validation improves feedback but does not replace server validation: the Server Action must call `schema.parse(...)` immediately, before its `try/catch`, as described above.
- Use React Hook Form's `formState.isSubmitting` for pending UI and display client-side validation errors next to their fields. Server-side `ZodError` must propagate to the caller or framework error handler; it is not a field-error Action result.

```ts
// src/features/posts/schemas/post.ts
import { z } from 'zod'

export const createPostSchema = z.object({
  title: z.string().trim().min(1).max(200),
  content: z.string().trim().min(1),
})

export type CreatePostInput = z.input<typeof createPostSchema>
export type CreatePostOutput = z.output<typeof createPostSchema>
```

```tsx
'use client'

import { zodResolver } from '@hookform/resolvers/zod'
import { useTranslations } from 'next-intl'
import { useForm } from 'react-hook-form'

import { createPost } from '@/features/posts/actions'
import { createPostSchema } from '@/features/posts/schemas/post'
import type { CreatePostInput, CreatePostOutput } from '@/features/posts/schemas/post'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'

export function PostForm(): JSX.Element {
  const t = useTranslations('PostForm')
  const {
    register,
    handleSubmit,
    setError,
    formState: { errors, isSubmitting },
  } = useForm<CreatePostInput, undefined, CreatePostOutput>({
    resolver: zodResolver(createPostSchema),
  })

  const onSubmit = async (values: CreatePostOutput): Promise<void> => {
    const result = await createPost(values)
    if (!result.success) {
      setError('root.server', { type: 'server', message: t(`errors.${result.error}`) })
    }
  }

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="flex flex-col gap-4">
      <Input {...register('title')} />
      {errors.title && <p className="text-destructive text-sm">{t('errors.title')}</p>}

      <Input {...register('content')} />
      {errors.content && <p className="text-destructive text-sm">{t('errors.content')}</p>}
      {errors.root?.server && (
        <p className="text-destructive text-sm" role="alert">
          {errors.root.server.message}
        </p>
      )}

      <Button type="submit" disabled={isSubmitting}>
        {isSubmitting ? t('saving') : t('save')}
      </Button>
    </form>
  )
}
```

## 3. Example - GOOD (Server Component + next-intl)

```tsx
// src/app/dashboard/page.tsx
import { getTranslations } from 'next-intl/server'
import { Suspense } from 'react'
import { env } from '@/env/server'
import { RecentOrders } from '@/components/recent-orders'
import { OrderSkeleton } from '@/components/order-skeleton'

export const revalidate = 60

interface Order {
  id: string
  total: number
  status: 'pending' | 'completed'
}

async function getOrders(): Promise<Order[]> {
  const res = await fetch(`${env.API_URL}/orders`, {
    next: { revalidate: 60 },
  })
  return res.json()
}

export default async function DashboardPage(): Promise<JSX.Element> {
  const t = await getTranslations('Dashboard')
  const orders = await getOrders()

  return (
    <main className="container mx-auto p-6">
      <h1 className="mb-6 text-3xl font-bold">{t('title')}</h1>
      <Suspense fallback={<OrderSkeleton />}>
        <RecentOrders orders={orders} />
      </Suspense>
    </main>
  )
}
```

## 17. Example — GOOD (Client Component + useOptimistic)

```tsx
// src/components/like-button.tsx
'use client'

import { useOptimistic } from 'react'
import { likePost } from '@/app/actions'
import { HeartIcon } from '@hugeicons/react'
import { cn } from '@/utils/cn'

interface LikeButtonProps {
  postId: string
  initialLikes: number
}

export function LikeButton({ postId, initialLikes }: LikeButtonProps): JSX.Element {
  const [optimisticLikes, addOptimisticLike] = useOptimistic(initialLikes, (state) => state + 1)

  const handleLike = async (): Promise<void> => {
    addOptimisticLike(undefined)
    await likePost(postId)
  }

  return (
    <button
      onClick={handleLike}
      className={cn(
        'inline-flex items-center gap-2 rounded-lg px-4 py-2',
        'bg-rose-500 text-white transition-colors hover:bg-rose-600',
      )}
    >
      <HeartIcon size={20} />
      <span>{optimisticLikes}</span>
    </button>
  )
}
```
